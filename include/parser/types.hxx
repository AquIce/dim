namespace dim {
	namespace parser {

		class DatatypeClass;
		class CustomDatatypeClass;

		typedef std::string DatatypeStr;

		typedef struct {
			std::shared_ptr<DatatypeClass> type;
			std::string name;
		} CustomDatatypeMember;

		inline bool operator==(
			const CustomDatatypeMember& lhs,
			const CustomDatatypeMember& rhs
		) {
			return lhs.name == rhs.name;
		}

    typedef struct {
      std::string name;
      DatatypeStr returnType;
      std::vector<DatatypeStr> argumentsTypes;
    } CustomDatatypeMemberFunction;

    inline bool operator==(
			const CustomDatatypeMemberFunction& lhs,
			const CustomDatatypeMemberFunction& rhs
		) {
			return lhs.name == rhs.name;
		}
	}
}

namespace std {
	template<>
	struct hash<
		std::pair<
			dim::parser::DatatypeStr,
			dim::parser::DatatypeStr
		>
	> {
		std::size_t operator()(
			const std::pair<dim::parser::DatatypeStr, dim::parser::DatatypeStr>& p
		) const {
			std::size_t h1 = std::hash<dim::parser::DatatypeStr>{}(p.first);
			std::size_t h2 = std::hash<dim::parser::DatatypeStr>{}(p.second);
			return h1 ^ (h2 << 1);
		}
	};

	template<>
	struct hash<
		dim::parser::CustomDatatypeMember
	> {
		std::size_t operator()(
			const dim::parser::CustomDatatypeMember& p
		) const {
			return std::hash<std::string_view>()(p.name);
		}
	};

  template<>
	struct hash<
		dim::parser::CustomDatatypeMemberFunction
	> {
		std::size_t operator()(
			const dim::parser::CustomDatatypeMemberFunction& p
		) const {
			return std::hash<std::string_view>()(p.name);
		}
	};
}

