struct {
	age: i32;
	name: str;
} User;

impl User {
	fn greet(void) -> str {
		return "Hello, " + this.name;
	}
};

main {

	var steve := User {
		.age = 21,
		.name = "Steve",
	};

	steve.name = "Not Steve";

	var a: str = loop(i @ -10..100) {
		match(i++) {
		15 -> {
			"I AM 15";
		}
		(> 10) -> {
		    "more than 10.";
		}
		_ -> {
			"I";
		}
		};
	} or "nope";

	steve.name;
};
